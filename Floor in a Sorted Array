class Solution {
  public:
    int findFloor(vector<int>& arr, int k) {
        int left = 0, right = arr.size() - 1;
        int floorIndex = -1;

        while (left <= right) {
            int mid = left + (right - left) / 2;

            if (arr[mid] == k) {
                return mid;  // If exact match found, return its index
            } else if (arr[mid] < k) {
                floorIndex = mid;  // Update floor index and search in the right half
                left = mid + 1;
            } else {
                right = mid - 1;  // Search in the left half
            }
        }
        return floorIndex;
    }
};
