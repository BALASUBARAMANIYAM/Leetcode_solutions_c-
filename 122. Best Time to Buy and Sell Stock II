class Solution {
public:
    int maxProfit(vector<int>& prices) {
        int max=0;
        int min =prices[0];
        for(int i=1;i<prices.size();i++)
        {
            int profit=prices[i]-min;
            if(profit>0)
            {
                max+=profit;
                min=prices[i];
            }
            if(prices[i]<min)
            {
                min=prices[i];
            }
        }
        return max;
    }
};
