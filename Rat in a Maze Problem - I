class Solution {
public:
    bool check(vector<vector<int>> &mat, int row, int col, int n) {
        return (row >= 0 && row < n && col >= 0 && col < n && mat[row][col] == 1);
    }

    void cal(vector<vector<int>> &mat, vector<string>& res, int n, int row, int col, string path) {
        // If we reach the destination, store the path
        if (row == n - 1 && col == n - 1) {
            res.push_back(path);
            return;
        }

        // Mark the cell as visited
        mat[row][col] = 0;

        // Explore all possible directions
        if (check(mat, row + 1, col, n)) { // Down
            cal(mat, res, n, row + 1, col, path + 'D');
        }
        if (check(mat, row, col - 1, n)) { // Left
            cal(mat, res, n, row, col - 1, path + 'L');
        }
        if (check(mat, row, col + 1, n)) { // Right
            cal(mat, res, n, row, col + 1, path + 'R');
        }
        if (check(mat, row - 1, col, n)) { // Up
            cal(mat, res, n, row - 1, col, path + 'U');
        }

        // Backtrack: Restore the cell
        mat[row][col] = 1;
    }

    vector<string> findPath(vector<vector<int>> &mat) {
        vector<string> res;
        int n = mat.size();

        // If start or end is blocked, return no path
        if (mat[0][0] == 0 || mat[n - 1][n - 1] == 0) {
            return res;
        }

        cal(mat, res, n, 0, 0, "");
        return res;
    }
};
