class Solution {
public:
    vector<int> nextGreaterElements(vector<int>& nums) {
        int n = nums.size();
        vector<int> res(n, -1);  // Initialize result vector with -1
        stack<int> st;

        // First pass: handle the circular nature by iterating twice
        for (int i = 2 * n - 1; i >= 0; i--) {
            int num = nums[i % n];  // Use modulo to handle circular indexing

            // Pop elements from the stack that are less than or equal to the current number
            while (!st.empty() && st.top() <= num) {
                st.pop();
            }

            // If the stack is not empty, the next greater element is the top of the stack
            if (!st.empty()) {
                res[i % n] = st.top();
            }

            // Push the current number onto the stack
            st.push(num);
        }

        return res;
    }
};


