class Solution {
public:
    int minDistance(string s, string t) {
        int n1 = s.size();
        int n2 = t.size();
        vector<vector<int>> mat(n1 + 1, vector<int>(n2 + 1));

        for (int i = 0; i <= n1; i++) {
            mat[i][0] = i;
        }
        for (int j = 0; j <= n2; j++) {
            mat[0][j] = j;
        }

        for (int i = 1; i <= n1; i++) {
            for (int j = 1; j <= n2; j++) {
                if (s[i - 1] == t[j - 1]) {
                    mat[i][j] = mat[i - 1][j - 1];
                } else {
                    mat[i][j] = min({mat[i - 1][j - 1], mat[i - 1][j], mat[i][j - 1]}) + 1;
                }
            }
        }
        return mat[n1][n2];
    }
};

