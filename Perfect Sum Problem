// RECURSION

class Solution {
public:
    void cal(vector<int>& arr, int target, int n, int& ans, int index, int sum) {
        if (index == n) {
            if (sum == target) {
                ans++;
            }
            return;
        }

        // Include the current element
        cal(arr, target, n, ans, index + 1, sum + arr[index]);

        // Exclude the current element
        cal(arr, target, n, ans, index + 1, sum);
    }

    int perfectSum(vector<int>& arr, int target) {
        int n = arr.size();
        int ans = 0;
        cal(arr, target, n, ans, 0, 0);
        return ans;
    }
};

