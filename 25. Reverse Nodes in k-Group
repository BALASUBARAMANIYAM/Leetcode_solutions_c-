class Solution {
public:
    ListNode* reverse(ListNode* head, int k) {
        ListNode* prev = nullptr;
        ListNode* cur = head;
        ListNode* next = nullptr;
        int count = 0;

        // Check if there are k nodes to reverse
        ListNode* temp = head;
        for (int i = 0; i < k; i++) {
            if (!temp) return head;  // If less than k nodes remain, do not reverse
            temp = temp->next;
        }

        // Reverse k nodes
        while (cur && count < k) {
            next = cur->next;
            cur->next = prev;
            prev = cur;
            cur = next;
            count++;
        }

        // Recur for the remaining list and connect
        if (next) {
            head->next = reverse(next, k);
        }

        return prev;  // New head of the reversed list
    }

    ListNode* reverseKGroup(ListNode* head, int k) {
        return reverse(head, k);
    }
};


