

class Solution {
public:
    bool wordBreak(string s, vector<string>& wordDict) {
        unordered_set<string> wordSet(wordDict.begin(), wordDict.end()); // Fast lookup O(1)
        int n = s.size();
        vector<bool> dp(n + 1, false); 
        dp[0] = true; // Base case: empty string is always valid

        for (int i = 1; i <= n; i++) { // Iterate over string length
            for (int j = 0; j < i; j++) { // Check all possible partitions
                if (dp[j] && wordSet.find(s.substr(j, i - j)) != wordSet.end()) {
                    dp[i] = true;
                    break;
                }
            }
        }
        return dp[n];
    }
};




