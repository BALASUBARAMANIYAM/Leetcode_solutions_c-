class Solution {
  public:
    // Function to check if Kth bit is set or not.
    bool checkKthBit(int n, int k) {
        
        vector<int>bin;
        
        int num = n;
        int count=0;
        while(num>0)
        {
            int x = (num%2);
            num=num/2;
            bin.push_back(x);
            if(count==k)
            {
                if(x==1)
                return true;
                return false;
            }
            count++;
        }
      return false;
    }
};
