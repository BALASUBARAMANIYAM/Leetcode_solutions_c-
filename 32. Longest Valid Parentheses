class Solution {
public:
    int longestValidParentheses(string s) {
        int left = 0, right = 0, maxi = 0;

        // Left to Right scan
        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '(') left++;
            else right++;

            if (left == right) {
                maxi = max(maxi, 2 * right);
            } else if (right > left) { // Reset when invalid
                left = right = 0;
            }
        }

        left = right = 0; // Reset for right-to-left scan

        // Right to Left scan
        for (int i = s.size() - 1; i >= 0; i--) {
            if (s[i] == ')') right++;
            else left++;

            if (left == right) {
                maxi = max(maxi, 2 * left);
            } else if (left > right) { // Reset when invalid
                left = right = 0;
            }
        }

        return maxi;
    }
};



class Solution {
public:
    int longestValidParentheses(string s) {
        stack<int> st;
        int maxLength = 0;
        int lastInvalid = -1;  // Stores the index of the last unmatched ')'

        for (int i = 0; i < s.size(); i++) {
            if (s[i] == '(') {
                st.push(i); // Store the index of '('
            } else {
                if (!st.empty()) {
                    st.pop(); // Match found, remove '(' index
                    if (st.empty()) {
                        maxLength = max(maxLength, i - lastInvalid);
                    } else {
                        maxLength = max(maxLength, i - st.top());
                    }
                } else {
                    lastInvalid = i; // Unmatched ')'
                }
            }
        }

        return maxLength;
    }
};

