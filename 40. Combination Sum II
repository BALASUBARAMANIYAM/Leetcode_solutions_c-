class Solution {
public:
    void check(vector<vector<int>>& ans,int ind,vector<int> cand,int tar,vector<int> temp)
    {
        if(tar==0)
        {
           ans.push_back(temp);
            return;
        }

        if(tar<0 || ind>=cand.size())
        return;
        temp.push_back(cand[ind]);
         check(ans,ind+1,cand,tar-cand[ind],temp);
         temp.pop_back();
         while (ind + 1 < cand.size() && cand[ind] == cand[ind + 1]) {
            ind++;
        }
          check(ans,ind+1,cand,tar,temp);
    }

    vector<vector<int>> combinationSum2(vector<int>& cand, int tar) {
        vector<vector<int>> ans;
        if(cand.size()==0)
        return ans;
        vector<int> temp;
        sort(cand.begin(),cand.end());
        check(ans,0,cand,tar,temp);
        return ans;
    }
};


//new method

class Solution {
public:
    void calc(vector<int>& candidates, int target, vector<vector<int>>& res,
              vector<int>& temp, int n, int index, int sum) {
        if (sum == target) {
            res.push_back(temp);
            return;
        }
        if (sum > target || index == n) {
            return;
        }

        // Include the current element
        temp.push_back(candidates[index]);
        calc(candidates, target, res, temp, n, index + 1, sum + candidates[index]);
        temp.pop_back();

        // Skip duplicate elements
        while (index + 1 < n && candidates[index] == candidates[index + 1]) {
            index++;
        }

        // Exclude the current element
        calc(candidates, target, res, temp, n, index + 1, sum);
    }

    vector<vector<int>> combinationSum2(vector<int>& candidates, int target) {
        vector<vector<int>> res;
        vector<int> temp;
        sort(candidates.begin(), candidates.end());  // Sort to handle duplicates
        int n = candidates.size();
        calc(candidates, target, res, temp, n, 0, 0);
        return res;
    }
};
