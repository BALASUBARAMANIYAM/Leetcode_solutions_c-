class Solution {
public:
void help(string digits,vector<string> res,vector<string>& v,int j,string temp)
{
    if(j==digits.size())
    {
        v.push_back(temp);
        return;
    }

    string chars=res[digits[j] - '0'];
    for(int i=0;i<chars.size();i++)
    {
        help(digits,res,v,j+1,temp+chars[i]);
    }

}
    vector<string> letterCombinations(string digits) {
        vector<string> v;
        vector<string> res;
        res={"","","abc","def","ghi","jkl","mno","pqrs","tuv","wxyz"};
        if(digits.size()==0)
        return v;
        help(digits,res,v,0,"");
        return v;
    }
};
