class Solution {
public:

bool isPalindrome(const string& str, int left, int right) {
        while (left < right) {
            if (str[left++] != str[right--]) return false;
        }
        return true;
    }

void calc(vector<vector<string>>&res,string s, vector<string> temp,int n,int index)
{
    if(index==n)
    {
        res.push_back(temp);
        return;
    }
      for(int i = index ; i<n;i++)
      {
           if(isPalindrome(s,index,i))
           {
            temp.push_back(s.substr(index,i-index+1));
            calc(res,s,temp,n,i+1);
            temp.pop_back();
           }
      }
}
    vector<vector<string>> partition(string s) {
         vector<vector<string>> res;
         int n = s.size();
         vector<string> temp;
         calc(res,s,temp,n,0);
         return res;
    }
};
