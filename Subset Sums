class Solution {
public:
    void check(vector<int>& ans, vector<int>& arr, int ind, int sum) {
        // Base case: if we've considered all elements
        if (ind == arr.size()) {
            ans.push_back(sum);
            return;
        }
        check(ans, arr, ind + 1, sum + arr[ind]);
        check(ans, arr, ind + 1, sum);
    }

    vector<int> subsetSums(vector<int> arr, int n) {
        vector<int> ans;
        check(ans, arr, 0, 0);
        return ans;
    }
};


RECURSION WITH FOR LOOP

class Solution {
  public:
  
  void calc(vector<int>arr,vector<int>&res , int n,int temp,int sum)
  {
      for(int i=temp;i<n;i++)
      {
          int tot = sum  + arr[i];
          res.push_back(tot);
          calc(arr,res,n,i+1,tot);
      }
      return ;
  }
  
  
    vector<int> subsetSums(vector<int>& arr) {
      vector<int> res;
      int n=arr.size();
      res.push_back(0);
      calc(arr,res,n,0,0);
      return res;
    }
};
