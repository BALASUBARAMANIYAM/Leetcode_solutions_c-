class Solution {
public:
    vector<int> searchRange(vector<int>& nums, int target) {
        int n= nums.size();
        int left=0;
        int right=n-1;
        int mid;
        int ind=-1;
        while(left<=right)
        {
            mid = (left+right)/2;
            if(nums[mid]==target)
            {
               ind=mid;
               break;
            }
            else if(nums[mid]>target)
            {
                right=mid-1;
            }
            else
            {
                left=mid+1;
            }
        }

        int mini=ind;
        int maxi=ind;
        if(ind==-1)
        {
            return {-1, -1};
        }
        else
        {
            for(int i=ind-1;i>=0;i--)
            {
               if(nums[i]==target)
               {
                   mini=i;
               }
            }
            for(int i=ind+1;i<n;i++)
            {
                if(nums[i]==target)
                {
                    maxi=i;
                }
            }
        }

        return {mini,maxi};
    }


};
