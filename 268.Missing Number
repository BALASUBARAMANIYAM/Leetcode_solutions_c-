class Solution {
public:
        int missingNumber(vector<int>& a) {
            int N=a.size();
    int totalSum = N * (N + 1) / 2; // Sum of first N natural numbers
    int arraySum = 0;

    for (int num : a) {
        arraySum += num;
    }

    return totalSum - arraySum; // Missing number
}
};
