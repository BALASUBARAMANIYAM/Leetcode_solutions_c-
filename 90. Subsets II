
class Solution {
public:
    void check(vector<int>& nums, vector<vector<int>>& ans, int ind, vector<int> temp) {
        ans.push_back(temp);
        if (ind >= nums.size()) return;
        for (int i = ind; i < nums.size(); i++) {
            if (i > ind && nums[i] == nums[i - 1]) continue;
            temp.push_back(nums[i]);
            check(nums, ans, i + 1, temp);
            temp.pop_back();
        }
    }


    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
        vector<vector<int>> ans;
        vector<int> temp;
        sort(nums.begin(), nums.end());
        check(nums, ans, 0, temp);
        return ans;
    }
};

//New method

class Solution {
public:
    void calc(vector<int>& nums, int n, vector<int>& temp, vector<vector<int>>& res, int index) {
        if (index == n) {
            res.push_back(temp);
            return;
        }

        // Include the current element
        temp.push_back(nums[index]);
        calc(nums, n, temp, res, index + 1);
        temp.pop_back();  

        // Skip duplicates
        while (index + 1 < n && nums[index] == nums[index + 1]) {
            index++;
        }

        // Exclude the current element
        calc(nums, n, temp, res, index + 1);
    }

    vector<vector<int>> subsetsWithDup(vector<int>& nums) {
        vector<vector<int>> res;
        vector<int> temp;
        sort(nums.begin(), nums.end());  // Sort to handle duplicates
        calc(nums, nums.size(), temp, res, 0);
        return res;
    }
};


