
class Solution {
public:
    int numDistinct(string s, string t) {
        int n1 = s.size();
        int n2 = t.size();

        // Use `unsigned long long` to prevent overflow
        vector<vector<unsigned long long>> mat(n1 + 1, vector<unsigned long long>(n2 + 1, 0));

        // Base case: An empty `t` is always a subsequence of `s`
        for (int i = 0; i <= n1; i++) mat[i][0] = 1;

        for (int i = 1; i <= n1; i++) {
            for (int j = 1; j <= n2; j++) {
                if (s[i - 1] == t[j - 1]) {
                    mat[i][j] = mat[i - 1][j - 1] + mat[i - 1][j];
                } else {
                    mat[i][j] = mat[i - 1][j];
                }
            }
        }
        return mat[n1][n2]; // The result will still fit in `int`
    }
};


