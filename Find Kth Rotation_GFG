class Solution {
  public:
    int findKRotation(vector<int> &arr) {
 
 int left = 0, right = arr.size() - 1;
        int ans = INT_MAX;
        int ind;
        while (left <= right) {
            int mid = left + (right - left) / 2;

             if(ans>arr[mid])
             {
                 ind = mid;
                 ans = arr[mid];
             }

            // If mid element is greater than right, the minimum is in the right half
            if (arr[mid] > arr[right]) {
                left = mid + 1;
            } else {
                right = mid - 1;
            }
        }

        return ind;
    }
};


NOTE : FIND THE MINIMUM ELEMENT IN THE ROTATED SORTED ARRAY AND RETURN ITS INDEX
