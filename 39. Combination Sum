#include <vector>
using namespace std;

class Solution {
public:
    void check(vector<vector<int>>& ans, vector<int> temp, int ind, vector<int>& cand, int target) {
        if (target == 0) {
            ans.push_back(temp);
            return;
        }
        if (ind >= cand.size() || target < 0) {
            return;
        }
        
        
        temp.push_back(cand[ind]);
        check(ans, temp, ind, cand, target - cand[ind]);  
       
        temp.pop_back();
        check(ans, temp, ind + 1, cand, target);  
    }

    vector<vector<int>> combinationSum(vector<int>& cand, int target) {
        vector<vector<int>> ans;
        vector<int> temp;
        check(ans, temp, 0, cand, target);
        return ans;
    }
};


//Next Method

class Solution {
public:
    void calc(vector<int>& candidates, int target,vector<vector<int>>&res,
        vector<int>&temp,int index,int n,int sum)
        {
            if(sum>target || index==n)
            {
                return;
            }
            if(sum==target)
            {
                res.push_back(temp);
                return;
            }
            temp.push_back(candidates[index]);
               calc(candidates,target,res,temp,index,n,sum+candidates[index]);
               temp.pop_back();
               calc(candidates,target,res,temp,index+1,n,sum);
        }
    vector<vector<int>> combinationSum(vector<int>& candidates, int target) {
        vector<vector<int>> res;
        vector<int> temp;
        int n = candidates.size();
        calc(candidates,target,res,temp,0,n,0);
        return res;
    }
};
